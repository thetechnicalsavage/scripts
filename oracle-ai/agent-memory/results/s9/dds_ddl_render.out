CREATE OR REPLACE DATA GRANT AGENTMEM.AGENTMEM_OPS_OAM_LOCAL_MEMORY_LINK_OWN_ROWS_SELECT_DG
AS SELECT
ON AGENTMEM.OPS_MEMORY_LINK
WHERE EXISTS (
    SELECT 1
    FROM AGENTMEM.OPS_MEMORY
    WHERE AGENTMEM.OPS_MEMORY.record_id = source_memory_id
)
  AND EXISTS (
    SELECT 1
    FROM AGENTMEM.OPS_MEMORY
    WHERE AGENTMEM.OPS_MEMORY.record_id = target_memory_id
)
TO AGENTMEM_OPS_OAM_OWN_USER_ROWS_CRUD_ROLE;

CREATE OR REPLACE DATA GRANT AGENTMEM.AGENTMEM_OPS_OAM_LOCAL_MEMORY_LINK_OWN_ROWS_DG
AS
    INSERT (
        relation_id,
        source_memory_id,
        source_memory_user_id,
        target_memory_id,
        target_memory_user_id,
        relation_type,
        opposite_relation_type,
        timestamp,
        metadata
    ),
    UPDATE (
        relation_type,
        opposite_relation_type,
        timestamp,
        metadata
    ),
    DELETE
ON AGENTMEM.OPS_MEMORY_LINK
WHERE source_memory_user_id = ORA_END_USER_CONTEXT.username
  AND target_memory_user_id = ORA_END_USER_CONTEXT.username
TO AGENTMEM_OPS_OAM_OWN_USER_ROWS_CRUD_ROLE;

CREATE OR REPLACE DATA GRANT AGENTMEM.AGENTMEM_OPS_OAM_LOCAL_RECORD_CHUNKS_OWN_ROWS_DG
AS
    SELECT,
    INSERT (
        source_id,
        source_record_type,
        source_emb_column,
        chunk_seq,
        chunk_text,
        thread_id,
        user_id,
        agent_id,
        status,
        embedding
    ),
    UPDATE (
        status
    ),
    DELETE
ON AGENTMEM.OPS_RECORD_CHUNKS
WHERE user_id = ORA_END_USER_CONTEXT.username
   OR (
       source_record_type = 'user_profile'
       AND source_id = ORA_END_USER_CONTEXT.username
   )
TO AGENTMEM_OPS_OAM_OWN_USER_ROWS_CRUD_ROLE;

CREATE OR REPLACE DATA GRANT AGENTMEM.AGENTMEM_OPS_OAM_LOCAL_ACTOR_PROFILE_OWN_USER_CRUD_DG
AS
    SELECT,
    INSERT (
        actor_id,
        actor_type,
        information,
        metadata,
        status
    ),
    UPDATE (
        information,
        metadata
    ),
    DELETE
ON AGENTMEM.OPS_ACTOR_PROFILE
WHERE actor_type = 'user'
  AND actor_id = ORA_END_USER_CONTEXT.username
TO AGENTMEM_OPS_OAM_OWN_USER_ROWS_CRUD_ROLE;

CREATE OR REPLACE DATA ROLE AGENTMEM_OPS_OAM_GLOBAL_READ_ROLE;

CREATE OR REPLACE DATA GRANT AGENTMEM.AGENTMEM_OPS_OAM_LOCAL_GLOBAL_READ_REGISTRY_SELECT_DG
