ON AGENTMEM.OPS_MEMORY
WHERE user_id IS NULL
TO AGENTMEM_OPS_OAM_GLOBAL_READ_ROLE;

CREATE OR REPLACE DATA GRANT AGENTMEM.AGENTMEM_OPS_OAM_LOCAL_GLOBAL_MEMORY_CHUNKS_SELECT_DG
AS SELECT
ON AGENTMEM.OPS_RECORD_CHUNKS
WHERE EXISTS (
    SELECT 1
    FROM AGENTMEM.OPS_MEMORY memory
    WHERE memory.record_id = source_id
      AND memory.memory_type = source_record_type
      AND memory.user_id IS NULL
)
TO AGENTMEM_OPS_OAM_GLOBAL_READ_ROLE;

CREATE OR REPLACE DATA GRANT AGENTMEM.AGENTMEM_OPS_OAM_LOCAL_GLOBAL_MEMORY_LINK_SELECT_DG
AS SELECT
ON AGENTMEM.OPS_MEMORY_LINK
WHERE EXISTS (
    SELECT 1
    FROM AGENTMEM.OPS_MEMORY
