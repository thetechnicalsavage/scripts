-- ===== add_deep_data_security_policies(conn, owner_schema='AGENTMEM', memory_store_id='OPS', policies=[UserOwnRows, GlobalMemories])
CREATE OR REPLACE DATA ROLE AGENTMEM_OPS_OAM_OWN_USER_ROWS_CRUD_ROLE;

CREATE OR REPLACE DATA GRANT AGENTMEM.AGENTMEM_OPS_OAM_LOCAL_OWN_ROWS_REGISTRY_SELECT_DG
AS SELECT
ON AGENTMEM.AGENT_MEMORY_STORES
TO AGENTMEM_OPS_OAM_OWN_USER_ROWS_CRUD_ROLE;

CREATE OR REPLACE DATA GRANT AGENTMEM.AGENTMEM_OPS_OAM_LOCAL_THREAD_OWN_ROWS_DG
AS
    SELECT,
    INSERT (
        record_id,
        user_id,
        agent_id,
        metadata,
        runtime_config,
        runtime_state
    ),
    UPDATE (
        metadata,
        runtime_config,
        runtime_state
    ),
    DELETE
ON AGENTMEM.OPS_THREAD
WHERE user_id = ORA_END_USER_CONTEXT.username
TO AGENTMEM_OPS_OAM_OWN_USER_ROWS_CRUD_ROLE;

CREATE OR REPLACE DATA GRANT AGENTMEM.AGENTMEM_OPS_OAM_LOCAL_THREAD_SUMMARY_OWN_ROWS_DG
AS
