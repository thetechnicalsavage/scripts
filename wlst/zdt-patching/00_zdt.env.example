# v1.5 2026-11-11 - blog copy (Codex r1): credential-file placeholders under /u01 (no home-directory paths).
# v1.4 2026-10-15 - t3s:// example admin URL.
# v1.3 2026-10-15 - HOOK_* settings for a home shared by several domains.
# v1.2 2026-10-15 - example paths for the existing common Oracle home and JDK (no per-domain homes).
# v1.1 2026-10-15 - DOMAIN_HOME added (06_verify.sh finds the domain's servers by it).
# v1.0 2026-10-15 - per-domain settings for the ZDT scripts. Copy to <domain>.env, edit, chmod 600.
#   Holds paths and names only. No passwords: WLST signs in with a user config/key file pair created once with
#   storeUserConfig() (see README), and the cacerts password is read from the CACERTS_PASS environment variable.

# Domain and its nodes (every node that runs a server of this domain)
DOMAIN_NAME=domainA
NODES="node1.example.com node2.example.com node3.example.com"
SSH_USER=oracle

# WLST connection to this domain's Administration Server
ADMIN_URL=t3s://node1.example.com:7002      # t3s needs the WLST trust keystore settings
WLST_USER_CONFIG=/u01/app/oracle/zdt-keys/domainA_config.secure
WLST_USER_KEY=/u01/app/oracle/zdt-keys/domainA_key.secure
# wlst.sh of an Oracle home of the same version (on Linux the domain's home is fine)
WLST_SH=/u01/app/oracle/product/fmw/oracle_common/common/bin/wlst.sh

# Domain home: outside the Oracle home, the same path on every node (a ZDT precondition)
DOMAIN_HOME=/u01/app/oracle/config/domains/domainA

# Oracle home the domain runs from (today's common Oracle home): local disk, the same path on every node.
# Every cluster that uses this home must be in the rollout: keep the target = the domain.
ORACLE_HOME=/u01/app/oracle/product/fmw
# JDK used when this Oracle home was installed (copyBinary/pasteBinary need it)
JAVA_HOME_INSTALL=/u01/app/oracle/product/jdk_2026Q3
# JDK the domain runs on today, and the new one (installed at the same path on every node)
JAVA_HOME_CURRENT=/u01/app/oracle/product/jdk_2026Q3
JAVA_HOME_NEW=/u01/app/oracle/product/jdk_2026Q4
# Optional: JDK archive (.tar.gz) to unpack into JAVA_HOME_NEW on every node
JDK_TARBALL=

# Patch cycle label, used in archive and backup names
CYCLE=2026Q4

# Build host only: staging area outside any Oracle home, and the downloaded patches
STAGE_DIR=/stage/zdt/fmw
PATCH_STAGE=/stage/patches/2026Q4      # one sub-directory per patch, named by patch number
PATCH_IDS=12345678,23456789            # patches to apply with opatch napply
SPB_DIR=                               # set instead of PATCH_IDS to apply a Stack Patch Bundle with SPBAT
OPATCH_EXTRA_ARGS=                     # extra OPatch flags, if your OPatch version supports them

# Rollout options
SHUTDOWN_TIMEOUT=1800                  # seconds; required while isSessionCompatible is FALSE (the default)
DELAY_BETWEEN_NODES=                   # seconds; empty = Oracle default (60)
MIGRATION_PROPERTIES=                  # JSON file for JMS/JTA migration, if migration policies need it
# Previous JDK, for a JDK-only rollback
JAVA_HOME_PREVIOUS=/u01/app/oracle/product/jdk_2026Q3

# Only when this Oracle home is also used by other domains on the same nodes (01_inventory.sh: shared_homes.csv).
# The hooks stop and start those domains' servers on the node being patched. Same paths on every node.
HOOK_JAR=                              # e.g. /u01/zdt/hooks/zdt_shared_home_hooks.jar (hooks/build_hook_jar.sh)
HOOK_PROPS=                            # e.g. /u01/zdt/hooks/extensionProperties.json (points to the jar and config)
HOOK_CONFIG=                           # e.g. /u01/zdt/hooks/other_domains.csv
